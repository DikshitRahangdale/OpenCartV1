<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

	<groups>
		<run>
			<include name="Smoke" />
			<exclude name="Sanity"/>
		</run>
	</groups>
	<test thread-count="5" name="Test">

		<parameter name="browsers" value="Chrome" />
		<classes>
			<class name="testCases.AccountRegisteration" />
			<class name="testCases.MyLoginTest" />
			<class name="testCases.LoginDataDrivenTest" />
		</classes>
	</test> <!-- Test -->
</suite> <!-- Suite -->
